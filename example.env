# Docusaurus Configuration
BLOG_ENABLED=true
DEPLOYMENT_URL=https://your-docusaurus-site.example.com
DEPLOYMENT_BRANCH=main
BASE_URL=/dev-blog/
GITHUB_ORG=4gh0rn
GITHUB_PROJECT=dev-blog

# Docker Configuration
# Container names
CONTAINER_NAME=docusaurus-blog
DEV_CONTAINER_NAME=docusaurus-dev

# Port mappings (host:container)
HOST_PORT=3000
CONTAINER_PORT=80
DEV_HOST_PORT=3001
DEV_CONTAINER_PORT=3000

# Network configuration
NETWORK_NAME=docusaurus-network

# Health check configuration
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=3s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=5s

# Resource limits (production)
CPU_LIMIT=1.0
MEMORY_LIMIT=512M
CPU_RESERVATION=0.25
MEMORY_RESERVATION=128M

# Resource limits (development)
DEV_CPU_LIMIT=1.0
DEV_MEMORY_LIMIT=1G
DEV_CPU_RESERVATION=0.25
DEV_MEMORY_RESERVATION=256M
